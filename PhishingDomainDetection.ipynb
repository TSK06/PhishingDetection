    "LABEL_MAP = {\"good\": 0, \"bad\": 1}\n",
    "CONFLICTING_URLS = {\"tommyhumphreys.com/\"}\n",
    "\n",
    "def prepare_dataset(dataframe, conflicting_urls=CONFLICTING_URLS):\n",
    "    \"\"\"Validate labels, report conflict groups, drop them, and deduplicate exact URLs.\"\"\"\n",
    "    label_counts = dataframe.groupby(\"URL\")[\"Label\"].nunique()\n",
    "    conflicts = set(label_counts[label_counts > 1].index)\n",
    "    if conflicts != set(conflicting_urls):\n",
    "        raise ValueError(f\"Unexpected conflicting URL groups: {conflicts}\")\n",
    "    conflict_rows = dataframe[dataframe[\"URL\"].isin(conflicts)].copy()\n",
    "    usable = dataframe[~dataframe[\"URL\"].isin(conflicts)].drop_duplicates(\"URL\", keep=\"first\").copy()\n",
    "    usable[\"Label\"] = usable[\"Label\"].map(LABEL_MAP).astype(\"int8\")\n",
    "    return usable, conflicts, conflict_rows\n",
    "\n",
    "def split_dataset(dataframe, seed=42):\n",
    "    \"\"\"Return fixed 70/15/15 stratified splits over unique exact URLs.\"\"\"\n",
    "    train, remainder = train_test_split(dataframe, test_size=0.30, random_state=seed, stratify=dataframe[\"Label\"])\n",
    "    validation, test = train_test_split(remainder, test_size=0.50, random_state=seed, stratify=remainder[\"Label\"])\n",
    "    url_sets = [set(part[\"URL\"]) for part in (train, validation, test)]\n",
    "    assert url_sets[0].isdisjoint(url_sets[1])\n",
    "    assert url_sets[0].isdisjoint(url_sets[2])\n",
    "    assert url_sets[1].isdisjoint(url_sets[2])\n",
    "    assert len(train) + len(validation) + len(test) == len(dataframe)\n",
    "    return train, validation, test\n",
    "\n",
    "def make_text_pipeline(tokenizer_function, classifier, vectorizer_class=CountVectorizer):\n",
    "    \"\"\"Build a pipeline whose vocabulary is learned only by fit on training text.\"\"\"\n",
    "    return Pipeline([\n",
    "        (\"vectorizer\", vectorizer_class(\n",
    "            tokenizer=tokenizer_function, token_pattern=None, lowercase=False\n",
    "        )),\n",
    "        (\"classifier\", classifier),\n",
    "    ])\n",
    "\n",
    "def make_cv(seed=42):\n",
    "    \"\"\"Three-fold shuffled stratification with a fixed seed.\"\"\"\n",
    "    return StratifiedKFold(n_splits=3, shuffle=True, random_state=seed)\n",
    "\n",
    "\n",
    "def build_candidate_config(seed=42):\n",
    "    \"\"\"Return active full-evaluation candidates and explicitly deferred models.\"\"\"\n",
    "    candidates = {\n",
    "        \"Logistic Regression\": (\n",
    "            LogisticRegression(max_iter=1000, random_state=seed),\n",
    "            {\"C\": [0.1, 1.0, 10.0]},\n",
    "        ),\n",
    "        \"LinearSVC\": (\n",
    "            LinearSVC(random_state=seed, max_iter=5000),\n",
    "            {\"C\": [0.1, 1.0]},\n",
    "        ),\n",
    "        \"Decision Tree\": (\n",
    "            DecisionTreeClassifier(random_state=seed),\n",
    "            {\"max_depth\": [10, 25, None]},\n",
    "        ),\n",
    "        \"Random Forest\": (\n",
    "            RandomForestClassifier(random_state=seed, n_jobs=-1),\n",
    "            {\"n_estimators\": [100], \"max_depth\": [None, 25]},\n",
    "        ),\n",
    "        \"XGBoost\": (\n",
    "            XGBClassifier(eval_metric=\"logloss\", random_state=seed, n_jobs=-1),\n",
    "            {\"n_estimators\": [100], \"max_depth\": [3, 6], \"learning_rate\": [0.1]},\n",
    "        ),\n",
    "    }\n",
    "    deferred_candidates = {\n",
    "        \"Gradient Boosting\": (\n",
    "            GradientBoostingClassifier(random_state=seed),\n",
    "            {\"n_estimators\": [100], \"learning_rate\": [0.1, 0.5], \"max_depth\": [2, 3]},\n",
    "        ),\n",
    "    }\n",
    "    return candidates, deferred_candidates\n"
