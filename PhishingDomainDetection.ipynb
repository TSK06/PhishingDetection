    "cv = make_cv(RANDOM_SEED)\n",
    "candidates, deferred_candidates = build_candidate_config(RANDOM_SEED)\n",
    "\n",
    "PREPROCESSING_CONFIG = {\n",
    "    \"tokenizer\": \"RegexpTokenizer(r'[A-Za-z]+') then SnowballStemmer('english')\",\n",
    "    \"vectorizer\": {\"class\": \"sklearn.feature_extraction.text.CountVectorizer\",\n",
    "                   \"token_pattern\": None, \"lowercase\": False,\n",
    "                   \"input\": \"raw URL text passed through tokenizer\"},\n",
    "}\n",
    "CHECKPOINT_DIRECTORY = Path(\"evaluation_checkpoints\") / f\"url_safety_seed_{RANDOM_SEED}\"\n",
    "\n",
    "\n",
    "def _json_safe(value):\n",
    "    \"\"\"Convert configuration values to deterministic JSON-compatible values.\"\"\"\n",
    "    if isinstance(value, np.generic):\n",
    "        return _json_safe(value.item())\n",
    "    if isinstance(value, dict):\n",
    "        return {str(key): _json_safe(item) for key, item in value.items()}\n",
    "    if isinstance(value, (list, tuple)):\n",
    "        return [_json_safe(item) for item in value]\n",
    "    if value is None or isinstance(value, (str, int, bool)):\n",
    "        return value\n",
    "    if isinstance(value, float):\n",
    "        return value if np.isfinite(value) else str(value)\n",
    "    if callable(value):\n",
    "        return f\"{value.__module__}.{getattr(value, '__qualname__', value.__name__)}\"\n",
    "    return f\"{type(value).__module__}.{type(value).__qualname__}\"\n",
    "\n",
    "\n",
    "def _canonical_json(value):\n",
    "    return json.dumps(_json_safe(value), sort_keys=True, separators=(\",\", \":\"), allow_nan=False)\n",
    "\n",
    "\n",
    "def _frame_fingerprint(texts, labels):\n",
    "    frame = pd.DataFrame({\"URL\": np.asarray(texts, dtype=object), \"Label\": np.asarray(labels)})\n",
    "    values = pd.util.hash_pandas_object(frame, index=False).values.tobytes()\n",
    "    return hashlib.sha256(values).hexdigest()\n",
    "\n",
    "\n",
    "def build_checkpoint_metadata(dataset_identity, training_text, training_labels,\n",
    "                              validation_text, validation_labels, seed, candidates,\n",
    "                              preprocessing_config):\n",
    "    \"\"\"Build metadata from dataset identity plus training/validation partitions only.\"\"\"\n",
    "    candidate_config = []\n",
    "    for name, (estimator, grid) in candidates.items():\n",
    "        candidate_config.append({\n",
    "            \"name\": name,\n",
    "            \"estimator_class\": f\"{type(estimator).__module__}.{type(estimator).__qualname__}\",\n",
    "            \"estimator_parameters\": _json_safe(estimator.get_params(deep=False)),\n",
    "            \"grid\": _json_safe(grid),\n",
    "        })\n",
    "    return {\n",
    "        \"schema_version\": 1,\n",
    "        \"dataset_identity\": str(dataset_identity),\n",
    "        \"split_metadata\": {\n",
    "            \"seed\": int(seed),\n",
    "            \"strategy\": \"stratified 70/15/15 split of deduplicated exact URLs\",\n",
    "            \"training_rows\": len(training_text),\n",
    "            \"training_identity\": _frame_fingerprint(training_text, training_labels),\n",
    "            \"validation_rows\": len(validation_text),\n",
    "            \"validation_identity\": _frame_fingerprint(validation_text, validation_labels),\n",
    "        },\n",
    "        \"candidate_configuration\": candidate_config,\n",
    "        \"preprocessing_configuration\": _json_safe(preprocessing_config),\n",
    "    }\n",
    "\n",
    "\n",
    "class CheckpointCompatibilityError(ValueError):\n",
    "    \"\"\"Raised when persisted metadata differs from this requested evaluation.\"\"\"\n",
    "\n",
    "\n",
    "class ResumableCheckpointStore:\n",
    "    \"\"\"JSON metrics/status checkpoints; fitted estimators are never serialized.\"\"\"\n",
    "    def __init__(self, directory, compatibility_metadata):\n",
    "        self.directory = Path(directory)\n",
    "        self.compatibility = _json_safe(compatibility_metadata)\n",
    "        self.compatibility_digest = hashlib.sha256(\n",
    "            _canonical_json(self.compatibility).encode(\"utf-8\")\n",
    "        ).hexdigest()\n",
    "        manifest = self.directory / \"manifest.json\"\n",
    "        if manifest.exists():\n",
    "            try:\n",
    "                existing = json.loads(manifest.read_text(encoding=\"utf-8\"))\n",
    "            except (OSError, json.JSONDecodeError) as error:\n",
    "                raise CheckpointCompatibilityError(\n",
    "                    f\"Checkpoint manifest is unreadable ({error}); select a fresh checkpoint directory.\"\n",
    "                ) from error\n",
    "            if existing != self.compatibility:\n",
    "                raise CheckpointCompatibilityError(\n",
    "                    \"Checkpoint compatibility mismatch (dataset, split, candidate, or preprocessing \"\n",
    "                    \"configuration changed). Existing files are untouched; select a fresh checkpoint \"\n",
    "                    \"directory to start a new run.\"\n",
    "                )\n",
    "        else:\n",
    "            if self.directory.exists() and any(self.directory.iterdir()):\n",
    "                raise CheckpointCompatibilityError(\n",
    "                    \"Checkpoint directory has files but no valid manifest; select a fresh directory.\"\n",
    "                )\n",
    "            self.directory.mkdir(parents=True, exist_ok=True)\n",
    "            self._atomic_write(manifest, self.compatibility)\n",
    "        self.fold_directory = self.directory / \"folds\"\n",
    "        self.validation_directory = self.directory / \"validation\"\n",
    "        self.fold_directory.mkdir(parents=True, exist_ok=True)\n",
    "        self.validation_directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    def _atomic_write(self, path, value):\n",
    "        path.parent.mkdir(parents=True, exist_ok=True)\n",
    "        temporary = path.with_name(path.name + \".tmp\")\n",
    "        with temporary.open(\"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n",
    "            json.dump(_json_safe(value), handle, sort_keys=True, indent=2, allow_nan=False)\n",
    "            handle.write(\"\\n\")\n",
    "            handle.flush()\n",
    "        temporary.replace(path)\n",
    "\n",
    "    def fold_path(self, candidate, parameters, fold_number, seed):\n",
    "        identity = {\"candidate\": candidate, \"parameters\": _json_safe(parameters),\n",
    "                    \"fold\": int(fold_number), \"seed\": int(seed)}\n",
    "        key = hashlib.sha256(_canonical_json(identity).encode(\"utf-8\")).hexdigest()\n",
    "        return self.fold_directory / f\"{key}.json\"\n",
    "\n",
    "    def save_fold(self, candidate, parameters, fold_number, seed, status,\n",
    "                  metrics=None, duration_seconds=0.0, error=None):\n",
    "        record = {\n",
    "            \"compatibility_digest\": self.compatibility_digest,\n",
    "            \"candidate\": candidate, \"parameters\": _json_safe(parameters),\n",
    "            \"fold\": int(fold_number), \"seed\": int(seed), \"status\": status,\n",
    "            \"metrics\": _json_safe(metrics), \"duration_seconds\": float(duration_seconds),\n",
    "        }\n",
    "        if error is not None:\n",
    "            record[\"error\"] = _json_safe(error)\n",
    "        self._atomic_write(self.fold_path(candidate, parameters, fold_number, seed), record)\n",
    "        return record\n",
    "\n",
    "    def load_completed_fold(self, candidate, parameters, fold_number, seed):\n",
    "        path = self.fold_path(candidate, parameters, fold_number, seed)\n",
    "        if not path.exists():\n",
    "            return None\n",
    "        try:\n",
    "            record = json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "        except (OSError, json.JSONDecodeError) as error:\n",
    "            print(f\"Invalid fold checkpoint {path.name}; rerunning this fold: {error}\", flush=True)\n",
    "            return None\n",
    "        valid_identity = (\n",
    "            record.get(\"compatibility_digest\") == self.compatibility_digest\n",
    "            and record.get(\"candidate\") == candidate\n",
    "            and record.get(\"parameters\") == _json_safe(parameters)\n",
    "            and record.get(\"fold\") == int(fold_number)\n",
    "            and record.get(\"seed\") == int(seed)\n",
    "        )\n",
    "        if valid_identity and record.get(\"status\") == \"complete\" and isinstance(record.get(\"metrics\"), dict):\n",
    "            return record\n",
    "        return None\n",
    "\n",
    "    def count_failed_folds(self):\n",
    "        count = 0\n",
    "        for path in self.fold_directory.glob(\"*.json\"):\n",
    "            try:\n",
    "                record = json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "                count += int(record.get(\"compatibility_digest\") == self.compatibility_digest\n",
    "                             and record.get(\"status\") == \"failed\")\n",
    "            except (OSError, json.JSONDecodeError):\n",
    "                continue\n",
    "        return count\n",
    "\n",
    "    def count_completed_fold_records(self):\n",
    "        count = 0\n",
    "        for path in self.fold_directory.glob(\"*.json\"):\n",
    "            try:\n",
    "                record = json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "                count += int(record.get(\"compatibility_digest\") == self.compatibility_digest\n",
    "                             and record.get(\"status\") == \"complete\")\n",
    "            except (OSError, json.JSONDecodeError):\n",
    "                continue\n",
    "        return count\n",
    "\n",
    "    def count_completed_validation_records(self):\n",
    "        count = 0\n",
    "        for path in self.validation_directory.glob(\"*.json\"):\n",
    "            try:\n",
    "                record = json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "                count += int(record.get(\"compatibility_digest\") == self.compatibility_digest\n",
    "                             and record.get(\"status\") == \"complete\")\n",
    "            except (OSError, json.JSONDecodeError):\n",
    "                continue\n",
    "        return count\n",
    "\n",
    "    def validation_path(self, candidate, parameters):\n",
    "        identity = {\"candidate\": candidate, \"parameters\": _json_safe(parameters)}\n",
    "        key = hashlib.sha256(_canonical_json(identity).encode(\"utf-8\")).hexdigest()\n",
    "        return self.validation_directory / f\"{key}.json\"\n",
    "\n",
    "    def load_validation(self, candidate, parameters):\n",
    "        path = self.validation_path(candidate, parameters)\n",
    "        if not path.exists():\n",
    "            return None\n",
    "        try:\n",
    "            record = json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "        except (OSError, json.JSONDecodeError) as error:\n",
    "            print(f\"Invalid validation checkpoint {path.name}; rerunning candidate validation: {error}\", flush=True)\n",
    "            return None\n",
    "        valid_identity = (\n",
    "            record.get(\"compatibility_digest\") == self.compatibility_digest\n",
    "            and record.get(\"candidate\") == candidate\n",
    "            and record.get(\"parameters\") == _json_safe(parameters)\n",
    "            and record.get(\"status\") == \"complete\"\n",
    "        )\n",
    "        return record if valid_identity else None\n",
    "\n",
    "    def save_validation(self, candidate, parameters, result):\n",
    "        record = {\"compatibility_digest\": self.compatibility_digest,\n",
    "                  \"candidate\": candidate, \"parameters\": _json_safe(parameters),\n",
    "                  \"status\": \"complete\", \"result\": _json_safe(result)}\n",
    "        self._atomic_write(self.validation_path(candidate, parameters), record)\n",
    "        return record\n",
    "\n",
    "    def save_validation_failure(self, candidate, parameters, error):\n",
    "        record = {\"compatibility_digest\": self.compatibility_digest,\n",
    "                  \"candidate\": candidate, \"parameters\": _json_safe(parameters),\n",
    "                  \"status\": \"failed\", \"error\": _json_safe(error)}\n",
    "        self._atomic_write(self.validation_path(candidate, parameters), record)\n",
    "\n",
    "    def finalize_selection(self, selected_name, selected_parameters, priority_metrics):\n",
    "        selection = {\n",
    "            \"compatibility_digest\": self.compatibility_digest,\n",
    "            \"status\": \"finalized\", \"selected_candidate\": selected_name,\n",
    "            \"selected_parameters\": _json_safe(selected_parameters),\n",
    "            \"priority_metrics\": _json_safe(priority_metrics),\n",
    "            \"selection_priority\": [\"phishing_recall\", \"phishing_f1\", \"phishing_precision\"],\n",
    "        }\n",
    "        path = self.directory / \"selection.json\"\n",
    "        if path.exists():\n",
    "            existing = json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "            if existing != selection:\n",
    "                raise CheckpointCompatibilityError(\n",
    "                    \"Finalized selection differs from stored selection; use a fresh checkpoint directory.\"\n",
    "                )\n",
    "        else:\n",
    "            self._atomic_write(path, selection)\n",
    "        return selection\n",
    "\n",
    "    def load_finalized_selection(self):\n",
    "        path = self.directory / \"selection.json\"\n",
    "        if not path.exists():\n",
    "            return None\n",
    "        selection = json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "        if (selection.get(\"compatibility_digest\") != self.compatibility_digest\n",
    "                or selection.get(\"status\") != \"finalized\"):\n",
    "            raise CheckpointCompatibilityError(\"Selection marker is invalid for this configuration.\")\n",
    "        return selection\n",
    "\n",
    "    def load_completed_test(self):\n",
    "        path = self.directory / \"held_out_test.json\"\n",
    "        if not path.exists():\n",
    "            return None\n",
    "        try:\n",
    "            record = json.loads(path.read_text(encoding=\"utf-8\"))\n",
    "        except (OSError, json.JSONDecodeError):\n",
    "            return None\n",
    "        valid = (record.get(\"compatibility_digest\") == self.compatibility_digest\n",
    "                 and record.get(\"status\") == \"complete\")\n",
    "        return record if valid else None\n",
    "\n",
    "    def save_test_status(self, status, selected_name, selected_parameters,\n",
    "                         metrics=None, error=None):\n",
    "        record = {\"compatibility_digest\": self.compatibility_digest,\n",
    "                  \"status\": status, \"selected_candidate\": selected_name,\n",
    "                  \"selected_parameters\": _json_safe(selected_parameters),\n",
    "                  \"metrics\": _json_safe(metrics)}\n",
    "        if error is not None:\n",
    "            record[\"error\"] = _json_safe(error)\n",
    "        self._atomic_write(self.directory / \"held_out_test.json\", record)\n",
    "        return record\n",
    "\n",
    "\n",
    "def metric_summary(y_true, y_pred):\n",
    "    return {\n",
    "        \"accuracy\": float(accuracy_score(y_true, y_pred)),\n",
    "        \"phishing_precision\": float(precision_score(y_true, y_pred, pos_label=PHISHING_LABEL, zero_division=0)),\n",
    "        \"phishing_recall\": float(recall_score(y_true, y_pred, pos_label=PHISHING_LABEL, zero_division=0)),\n",
    "        \"phishing_f1\": float(f1_score(y_true, y_pred, pos_label=PHISHING_LABEL, zero_division=0)),\n",
    "        \"confusion_matrix\": confusion_matrix(y_true, y_pred, labels=[0, 1]).tolist(),\n",
    "    }\n",
    "\n",
    "\n",
    "def _take_rows(values, indices):\n",
    "    return values.iloc[indices] if hasattr(values, \"iloc\") else np.asarray(values)[indices]\n",
    "\n",
    "\n",
    "def _emit_fit_progress(progress_callback, event):\n",
    "    if progress_callback is not None:\n",
    "        progress_callback(event)\n",
    "        return\n",
    "    eta = event.get(\"estimated_remaining_seconds\")\n",
    "    eta_text = \"n/a\" if eta is None else f\"~{eta:.1f}s (estimate)\"\n",
    "    print(\n",
    "        \"Progress: {overall_completed}/{planned_total_fits} completed; candidate={candidate}; \"\n",
    "        \"params={parameters}; fold={fold}; fit={fit_duration_seconds:.2f}s; \"\n",
    "        \"cumulative={cumulative_elapsed_seconds:.1f}s; failed={failed_fit_count}; \"\n",
    "        \"remaining={remaining_fits}; ETA={eta}\".format(eta=eta_text, **event),\n",
    "        flush=True,\n",
    "    )\n",
    "\n",
    "\n",
    "def run_resumable_cv(candidates, training_text, training_labels, cv,\n",
    "                     tokenizer_function, checkpoint_store, seed=42,\n",
    "                     vectorizer_class=CountVectorizer, planned_total_fits=None,\n",
    "                     progress_callback=None, cumulative_start_time=None):\n",
    "    \"\"\"Fit one train-only CV fold at a time, saving its metrics before proceeding.\"\"\"\n",
    "    parameter_sets = {name: list(ParameterGrid(grid)) for name, (_, grid) in candidates.items()}\n",
    "    planned_cv_fits = sum(map(len, parameter_sets.values())) * cv.get_n_splits()\n",
    "    planned_total_fits = planned_total_fits or planned_cv_fits\n",
    "    prior_validation = checkpoint_store.count_completed_validation_records()\n",
    "    completed_cv = 0\n",
    "    failed_count = checkpoint_store.count_failed_folds()\n",
    "    durations = []\n",
    "    run_start = cumulative_start_time or time.perf_counter()\n",
    "    splits = list(cv.split(np.zeros(len(training_labels)), training_labels))\n",
    "    cv_results = {}\n",
    "    for name, (base_estimator, _) in candidates.items():\n",
    "        candidate_results = []\n",
    "        for parameters in parameter_sets[name]:\n",
    "            fold_metrics = []\n",
    "            for fold_number, (fold_train, fold_valid) in enumerate(splits, start=1):\n",
    "                cached = checkpoint_store.load_completed_fold(name, parameters, fold_number, seed)\n",
    "                if cached is not None:\n",
    "                    metrics = cached[\"metrics\"]\n",
    "                    fit_duration = float(cached.get(\"duration_seconds\", 0.0))\n",
    "                    status = \"checkpoint_reused\"\n",
    "                    durations.append(fit_duration)\n",
    "                else:\n",
    "                    pipeline = make_text_pipeline(\n",
    "                        tokenizer_function, clone(base_estimator).set_params(**parameters),\n",
    "                        vectorizer_class=vectorizer_class,\n",
    "                    )\n",
    "                    started = time.perf_counter()\n",
    "                    try:\n",
    "                        pipeline.fit(_take_rows(training_text, fold_train),\n",
    "                                     _take_rows(training_labels, fold_train))\n",
    "                        predictions = pipeline.predict(_take_rows(training_text, fold_valid))\n",
    "                        metrics = metric_summary(_take_rows(training_labels, fold_valid), predictions)\n",
    "                        fit_duration = time.perf_counter() - started\n",
    "                        checkpoint_store.save_fold(name, parameters, fold_number, seed,\n",
    "                                                   \"complete\", metrics, fit_duration)\n",
    "                        status = \"completed\"\n",
    "                        durations.append(fit_duration)\n",
    "                    except Exception as error:\n",
    "                        fit_duration = time.perf_counter() - started\n",
    "                        failed_count += 1\n",
    "                        checkpoint_store.save_fold(\n",
    "                            name, parameters, fold_number, seed, \"failed\",\n",
    "                            duration_seconds=fit_duration,\n",
    "                            error={\"type\": type(error).__name__, \"message\": str(error)},\n",
    "                        )\n",
    "                        _emit_fit_progress(progress_callback, {\n",
    "                            \"overall_completed\": completed_cv + prior_validation,\n",
    "                            \"planned_total_fits\": planned_total_fits,\n",
    "                            \"candidate\": name, \"parameters\": _json_safe(parameters),\n",
    "                            \"fold\": fold_number, \"fit_duration_seconds\": fit_duration,\n",
    "                            \"cumulative_elapsed_seconds\": time.perf_counter() - run_start,\n",
    "                            \"failed_fit_count\": failed_count,\n",
    "                            \"remaining_fits\": max(0, planned_total_fits-completed_cv-prior_validation),\n",
    "                            \"estimated_remaining_seconds\": None, \"status\": \"failed\",\n",
    "                        })\n",
    "                        raise\n",
    "                fold_metrics.append(metrics)\n",
    "                completed_cv += 1\n",
    "                overall = completed_cv + prior_validation\n",
    "                remaining = max(0, planned_total_fits - overall)\n",
    "                eta = float(np.mean(durations)) * remaining if durations else None\n",
    "                _emit_fit_progress(progress_callback, {\n",
    "                    \"overall_completed\": overall, \"planned_total_fits\": planned_total_fits,\n",
    "                    \"candidate\": name, \"parameters\": _json_safe(parameters),\n",
    "                    \"fold\": fold_number, \"fit_duration_seconds\": fit_duration,\n",
    "                    \"cumulative_elapsed_seconds\": time.perf_counter()-run_start,\n",
    "                    \"failed_fit_count\": failed_count, \"remaining_fits\": remaining,\n",
    "                    \"estimated_remaining_seconds\": eta, \"status\": status,\n",
    "                })\n",
    "            candidate_results.append({\n",
    "                \"parameters\": _json_safe(parameters),\n",
    "                \"cv_phishing_recall\": float(np.mean([m[\"phishing_recall\"] for m in fold_metrics])),\n",
    "                \"fold_metrics\": fold_metrics,\n",
    "            })\n",
    "        best = max(candidate_results, key=lambda result: result[\"cv_phishing_recall\"])\n",
    "        cv_results[name] = candidate_results\n",
    "        print(f\"CV candidate summary: {name}; best parameters={best['parameters']}; \"\n",
    "              f\"mean three-fold phishing recall={best['cv_phishing_recall']:.6f}\", flush=True)\n",
    "    return cv_results\n",
    "\n",
    "\n",
    "def evaluate_candidates(candidates, cv_results, training_text, training_labels,\n",
    "                        validation_text, validation_labels, tokenizer_function,\n",
    "                        checkpoint_store, planned_total_fits,\n",
    "                        progress_callback=None, vectorizer_class=CountVectorizer, cumulative_start_time=None):\n",
    "    \"\"\"Use train-only CV then validation; persist each candidate before selection.\"\"\"\n",
    "    rows, fitted = [], {}\n",
    "    completed_validation = checkpoint_store.count_completed_validation_records()\n",
    "    failed_count = checkpoint_store.count_failed_folds()\n",
    "    run_start = cumulative_start_time or time.perf_counter()\n",
    "    for name, (base_estimator, _) in candidates.items():\n",
    "        best_cv = max(cv_results[name], key=lambda result: result[\"cv_phishing_recall\"])\n",
    "        parameters = best_cv[\"parameters\"]\n",
    "        cached = checkpoint_store.load_validation(name, parameters)\n",
    "        if cached is not None:\n",
    "            result, model, status, duration = cached[\"result\"], None, \"validation_checkpoint_reused\", 0.0\n",
    "        else:\n",
    "            model = make_text_pipeline(\n",
    "                tokenizer_function, clone(base_estimator).set_params(**parameters),\n",
    "                vectorizer_class=vectorizer_class,\n",
    "            )\n",
    "            started = time.perf_counter()\n",
    "            try:\n",
    "                model.fit(training_text, training_labels)\n",
    "                result = {\n",
    "                    \"model\": name, \"best_parameters\": _json_safe(parameters),\n",
    "                    \"cv_phishing_recall\": best_cv[\"cv_phishing_recall\"],\n",
    "                    \"train\": metric_summary(training_labels, model.predict(training_text)),\n",
    "                    \"validation\": metric_summary(validation_labels, model.predict(validation_text)),\n",
    "                }\n",
    "                duration = time.perf_counter() - started\n",
    "                checkpoint_store.save_validation(name, parameters, result)\n",
    "                fitted[name] = model\n",
    "                completed_validation += 1\n",
    "                status = \"validation_completed\"\n",
    "            except Exception as error:\n",
    "                checkpoint_store.save_validation_failure(name, parameters,\n",
    "                    {\"type\": type(error).__name__, \"message\": str(error)})\n",
    "                raise\n",
    "        rows.append(result)\n",
    "        vm = result[\"validation\"]\n",
    "        print(f\"Validation candidate summary: {name}; params={parameters}; \"\n",
    "              f\"recall={vm['phishing_recall']:.6f}; F1={vm['phishing_f1']:.6f}; \"\n",
    "              f\"precision={vm['phishing_precision']:.6f}; status={status}\", flush=True)\n",
    "        overall = checkpoint_store.count_completed_fold_records() + completed_validation\n",
    "        remaining = max(0, planned_total_fits-overall)\n",
    "        _emit_fit_progress(progress_callback, {\n",
    "            \"overall_completed\": overall, \"planned_total_fits\": planned_total_fits,\n",
    "            \"candidate\": name, \"parameters\": _json_safe(parameters), \"fold\": \"refit/validation\",\n",
    "            \"fit_duration_seconds\": duration, \"cumulative_elapsed_seconds\": time.perf_counter()-run_start,\n",
    "            \"failed_fit_count\": failed_count, \"remaining_fits\": remaining,\n",
    "            \"estimated_remaining_seconds\": None, \"status\": status,\n",
    "        })\n",
    "    selected = max(rows, key=lambda row: (row[\"validation\"][\"phishing_recall\"],\n",
    "                                          row[\"validation\"][\"phishing_f1\"],\n",
    "                                          row[\"validation\"][\"phishing_precision\"]))\n",
    "    checkpoint_store.finalize_selection(selected[\"model\"], selected[\"best_parameters\"], selected[\"validation\"])\n",
    "    selected_model = fitted.get(selected[\"model\"])\n",
    "    if selected_model is None:\n",
    "        selected_model = make_text_pipeline(\n",
    "            tokenizer_function,\n",
    "            clone(candidates[selected[\"model\"]][0]).set_params(**selected[\"best_parameters\"]),\n",
    "            vectorizer_class=vectorizer_class,\n",
    "        )\n",
    "        # JSON checkpoints deliberately omit estimators; a resumed run rebuilds the winner on train only.\n",
    "        selected_model.fit(training_text, training_labels)\n",
    "    table = pd.DataFrame([\n",
    "        {\"model\": row[\"model\"], \"best_parameters\": row[\"best_parameters\"],\n",
    "         \"cv_phishing_recall\": row[\"cv_phishing_recall\"],\n",
    "         **{f\"train_{k}\": v for k, v in row[\"train\"].items() if k != \"confusion_matrix\"},\n",
    "         **{f\"validation_{k}\": v for k, v in row[\"validation\"].items() if k != \"confusion_matrix\"}}\n",
    "        for row in rows\n",
    "    ]).sort_values([\"validation_phishing_recall\", \"validation_phishing_f1\",\n",
    "                    \"validation_phishing_precision\"], ascending=False)\n",
    "    print(\"Selection finalized by validation phishing recall, then F1, then precision: \"\n",
    "          f\"{selected['model']} {selected['best_parameters']}\", flush=True)\n",
    "    return rows, selected_model, selected[\"model\"], selected[\"best_parameters\"], table\n",
    "\n",
    "\n",
    "def evaluate_held_out_once(selected_estimator, test_text, test_labels,\n",
    "                           checkpoint_store, selected_name, selected_parameters):\n",
    "    \"\"\"Require finalized selection and persist a one-time held-out test result.\"\"\"\n",
    "    selection = checkpoint_store.load_finalized_selection()\n",
    "    if selection is None:\n",
    "        raise RuntimeError(\"Held-out test evaluation is blocked until model selection is finalized.\")\n",
    "    if (selection[\"selected_candidate\"] != selected_name\n",
    "            or selection[\"selected_parameters\"] != _json_safe(selected_parameters)):\n",
    "        raise CheckpointCompatibilityError(\"Test candidate differs from the finalized selection.\")\n",
    "    completed = checkpoint_store.load_completed_test()\n",
    "    if completed is not None:\n",
    "        return None, completed[\"metrics\"]\n",
    "    if selected_estimator is None:\n",
    "        raise RuntimeError(\"A selected fitted estimator is required for the first held-out evaluation.\")\n",
    "    checkpoint_store.save_test_status(\"running\", selected_name, selected_parameters)\n",
    "    try:\n",
    "        predictions = selected_estimator.predict(test_text)\n",
    "        metrics = metric_summary(test_labels, predictions)\n",
    "    except Exception as error:\n",
    "        checkpoint_store.save_test_status(\"failed\", selected_name, selected_parameters,\n",
    "            error={\"type\": type(error).__name__, \"message\": str(error)})\n",
    "        raise\n",
    "    checkpoint_store.save_test_status(\"complete\", selected_name, selected_parameters, metrics)\n",
    "    return predictions, metrics\n",
    "\n",
    "\n",
    "# Checkpoints contain JSON configuration, metrics and status only, never fitted models.\n",
    "checkpoint_metadata = build_checkpoint_metadata(\n",
    "    DATASET_IDENTITY, X_train_text, y_train, X_validation_text, y_validation,\n",
    "    RANDOM_SEED, candidates, PREPROCESSING_CONFIG,\n",
    ")\n",
    "checkpoint_store = ResumableCheckpointStore(CHECKPOINT_DIRECTORY, checkpoint_metadata)\n",
    "cv_fit_plan = {name: len(list(ParameterGrid(grid))) * cv.get_n_splits()\n",
    "               for name, (_, grid) in candidates.items()}\n",
    "planned_cv_fits = sum(cv_fit_plan.values())\n",
    "planned_validation_refits = len(candidates)\n",
    "planned_total_fits = planned_cv_fits + planned_validation_refits\n",
    "print(\"Dataset rows:\", len(df_usable))\n",
    "print(\"Train / validation / untouched test rows:\", len(train_df), len(validation_df), len(test_df))\n",
    "print(\"CV fits by candidate:\", cv_fit_plan)\n",
    "print(\"Planned CV folds:\", planned_cv_fits)\n",
    "print(\"Planned candidate refits/validation evaluations:\", planned_validation_refits)\n",
    "print(\"Total planned search and validation fits:\", planned_total_fits)\n",
    "print(\"Checkpoint directory:\", CHECKPOINT_DIRECTORY)\n",
    "print(\"Full evaluation may require substantial time and memory; no downsampling will occur.\")\n",
    "print(\"Only JSON metrics/status are saved; production model artifacts are not written.\", flush=True)\n",
    "\n",
    "evaluation_started_at = time.perf_counter()\n",
    "cv_results = run_resumable_cv(\n",
    "    candidates, X_train_text, y_train, cv, tokenize_prepared_url,\n",
    "    checkpoint_store, seed=RANDOM_SEED, planned_total_fits=planned_total_fits,\n",
    "    cumulative_start_time=evaluation_started_at,\n",
    ")\n",
    "selection_rows, selected_pipeline, selected_name, selected_parameters, selection_table = evaluate_candidates(\n",
    "    candidates, cv_results, X_train_text, y_train, X_validation_text, y_validation,\n",
    "    tokenize_prepared_url, checkpoint_store, planned_total_fits,\n",
    "    cumulative_start_time=evaluation_started_at,\n",
    ")\n",
    "selection_table"
   ]
  },
