{
  "manifest_version": 3,
  "name": "PhishSite Checker",
  "version": "1.0",
  "description": "Classifies websites as safe or malicious",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon.png"
    }
  },
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:8000/*"]
}
